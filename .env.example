# Токен бота от @BotFather
BOT_TOKEN=
# Публичный HTTPS-адрес Mini App (например https://studio.example.com)
WEBAPP_URL=
# Telegram ID через запятую. Первый — владелица (owner), остальные — помощники (assistant)
ALLOWED_TG_IDS=
PORT=3000
# Сколько секунд подпись initData считается действительной
INITDATA_MAX_AGE_SEC=86400
DB_FILE=data/studio.db
